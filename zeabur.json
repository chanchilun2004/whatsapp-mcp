{
  "$schema": "https://schema.zeabur.app/template.json",
  "build": {
    "type": "dockerfile",
    "dockerfile": "Dockerfile"
  },
  "ports": [
    {
      "port": 8000,
      "type": "http",
      "description": "MCP SSE endpoint"
    },
    {
      "port": 8080,
      "type": "http",
      "description": "WhatsApp Bridge API (QR code + internal API)"
    }
  ],
  "volumes": [
    {
      "id": "whatsapp-data",
      "dir": "/data"
    }
  ],
  "env": {
    "DATA_DIR": "/data",
    "BRIDGE_PORT": "8080",
    "MCP_TRANSPORT": "sse",
    "FASTMCP_PORT": "8000",
    "MESSAGES_DB_PATH": "/data/messages.db",
    "WHATSAPP_API_URL": "http://localhost:8080/api"
  }
}
